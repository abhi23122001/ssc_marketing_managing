# ==============================================================================
# SHAH GROUP AI OS — CENTRAL CREDENTIALS & INTEGRATION CONFIGURATION
# ==============================================================================
# All keys placed here are completely safe and ignored by Git (.gitignore).

# ------------------------------------------------------------------------------
# 1. GOOGLE CLOUD (Drive, Sheets & YouTube Data API)
# ------------------------------------------------------------------------------
# Method A: Place your downloaded 'client_secret.json' inside the credentials/ directory:
#   credentials/client_secret.json
# OR set the path / raw credentials below:
GOOGLE_APPLICATION_CREDENTIALS=credentials/client_secret.json
GOOGLE_CLIENT_SECRET=
YOUTUBE_API_KEY=

# ------------------------------------------------------------------------------
# 2. META PLATFORMS (Instagram Graph API & Facebook Pages)
# ------------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_USER_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_CLIENT_SECRET=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 3. AI INFERENCE (OpenRouter / Hermes / Free Models)
# ------------------------------------------------------------------------------
# Default is 100% FREE (stepfun/step-3.7-flash:free).
# If you have your own OpenRouter or Nous API key, paste it below:
OPENROUTER_API_KEY=

# ------------------------------------------------------------------------------
# 4. SYSTEM & SERVER SETTINGS
# ------------------------------------------------------------------------------
SGCC_SERVER_PORT=8899
SGCC_ENVIRONMENT=production
